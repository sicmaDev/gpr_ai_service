# Base SQL dediee au reporting IA.
# En production, utiliser un compte SQL dedie et un mot de passe gere par
# l'environnement de deploiement.
REPORTING_DATABASE_URL=mysql+pymysql://reporting_user:change-me@localhost:3306/gpr_ai_reporting?charset=utf8mb4
JAVA_EXPORT_CLAIMS_URL=http://localhost:8020/api/v1/ai/export-claims
REPORTING_ENABLE_RAG_SYNC=false
REPORTING_TIMEZONE=Africa/Abidjan
REPORTING_SLA_DAYS=3
